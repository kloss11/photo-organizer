<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoOrganizer.Presentation\PhotoOrganizer.Presentation.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Application\PhotoOrganizer.Application.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Infrastructure\PhotoOrganizer.Infrastructure.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Platform.Abstractions\PhotoOrganizer.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Domain\PhotoOrganizer.Domain.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Platform.Windows\PhotoOrganizer.Platform.Windows.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Platform.Linux\PhotoOrganizer.Platform.Linux.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Platform.MacOS\PhotoOrganizer.Platform.MacOS.csproj" />
    <ProjectReference Include="..\PhotoOrganizer.Platform.Shared\PhotoOrganizer.Platform.Shared.csproj" />
  </ItemGroup>
</Project>
