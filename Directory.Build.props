<Project>
  <!--
    Wspólne ustawienia budowania dla całego rozwiązania.
    TargetFramework ustawia każdy projekt osobno (Platform.Windows używa net10.0-windows).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Metadane produktu (wstrzykiwane do wszystkich assembly). -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>PhotoOrganizer</Product>
    <Authors>Marcin Nadolny</Authors>
    <Company>Marcin Nadolny</Company>
    <Copyright>Copyright © 2026 Marcin Nadolny</Copyright>
    <RepositoryUrl>https://github.com/kloss11/photo-organizer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
